# =============================================================================
# MAGIK .gitignore
#
# Rule of thumb: source code, config, and documentation are TRACKED.
# Anything regenerable, environment-specific, secret, or user/runtime data
# is IGNORED. See section headers below for the reasoning on each group.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# -----------------------------------------------------------------------------
# Folders tracked as structure only — the directory ships via .gitkeep, but
# its contents (corpus files, user uploads, generated indexes, run logs,
# docs, and ad-hoc scripts) are local/regenerable and stay out of git.
# -----------------------------------------------------------------------------
data/*
!data/.gitkeep

docs/*
!docs/.gitkeep

logs/*
!logs/.gitkeep

scripts/*
!scripts/.gitkeep

mlruns/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Python — byte-compiled files, packaging, caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
rag_env/

# -----------------------------------------------------------------------------
# ML model caches & local weights — large, regenerable via download script
# (see app/bin/models/download_all_models.py)
# -----------------------------------------------------------------------------
.hf_cache/
.torch_cache/
.cuda_compat/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# -----------------------------------------------------------------------------
# Node / frontend (ui/)
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/
.cursorignore
.cursorindexingignore
.spyderproject
.spyproject
.ropeproject
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Claude Code project state — kept local, not shared via git
# -----------------------------------------------------------------------------
.claude/
CLAUDE.md

# -----------------------------------------------------------------------------
# Generated security/supply-chain artifacts (`make sbom`, `make security-scan`)
# Regenerated on demand and per-environment — CI publishes the authoritative
# ones as workflow artifacts (see .github/workflows/cd.yml + security.yml).
# -----------------------------------------------------------------------------
sbom.local.json
sbom.spdx.json
trivy-results.sarif
bandit-report.json
pip-audit-report.json
licenses-report.json

# -----------------------------------------------------------------------------
# Misc tooling
# -----------------------------------------------------------------------------
.pypirc
*.exe
