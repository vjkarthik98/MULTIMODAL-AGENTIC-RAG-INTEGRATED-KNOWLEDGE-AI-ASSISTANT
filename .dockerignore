# Version control / CI / editor
.git/
.github/
.claude/
.vscode/
.idea/

# Never bake secrets or local env into the image
.env
.env.*
!.env.example

# Models, user data, indexes — always volume-mounted, never baked in
.hf_cache/
.torch_cache/
data/
mlruns/
logs/

# Frontend source IS needed — the Dockerfile's `ui-builder` stage compiles it
# into /app/ui_dist, which app/main.py serves at /. Only the generated/vendored
# parts are excluded (node_modules/ and dist/ below are unprefixed patterns, so
# they already match ui/node_modules/ and ui/dist/ at any depth — same rule
# .gitignore uses). A blanket `ui/` line here was a leftover from before the
# static mount existed; it silently emptied the ui-builder stage's COPY and
# broke every build until caught by a real failed run (2026-07-29).
node_modules/

# Docs, notebooks, scripts not needed at runtime
docs/
notebooks/
scripts/
deploy/
monitoring/
*.md
CHANGELOG.md
README.md

# Tests — not shipped in the runtime image.
#
# A `!tests/guardrails/adversarial/red_team_prompts.jsonl` negation used to
# live here (2026-07-30) to re-include jailbreak.py's semantic corpus after
# the blanket `tests/` exclusion below. It didn't actually work — a live
# Tier-2 eval run on 2026-07-31 still showed `jailbreak_corpus_not_found` /
# corpus_size=0 in production, proving Docker's real BuildKit .dockerignore
# engine does not reliably re-include a file once its parent directory is
# excluded (unlike the `pathspec` Python library, which simulates .gitignore
# semantics and misled the earlier verification). Fixed at the root instead:
# the corpus now lives under app/guardrails/resources/ (ships normally via
# COPY app/ app/, no negation needed) and tests/ read from that same
# location — see tests/guardrails/conftest.py.
tests/

# Python / tooling caches
__pycache__/
*.py[codz]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# Virtualenvs
rag_env/
.venv/
venv/

# Host-only provisioning scripts — Dockerfile replicates the needed flags directly
install_cuda.sh
.cuda_compat/
