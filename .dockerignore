# Version control / CI / editor
.git/
.github/
.claude/
.vscode/
.idea/

# Never bake secrets or local env into the image
.env
.env.*
!.env.example

# Models, user data, indexes — always volume-mounted, never baked in
.hf_cache/
.torch_cache/
data/
mlruns/
logs/

# Frontend source IS needed — the Dockerfile's `ui-builder` stage compiles it
# into /app/ui_dist, which app/main.py serves at /. Only the generated/vendored
# parts are excluded (node_modules/ and dist/ below are unprefixed patterns, so
# they already match ui/node_modules/ and ui/dist/ at any depth — same rule
# .gitignore uses). A blanket `ui/` line here was a leftover from before the
# static mount existed; it silently emptied the ui-builder stage's COPY and
# broke every build until caught by a real failed run (2026-07-29).
node_modules/

# Docs, notebooks, scripts not needed at runtime
docs/
notebooks/
scripts/
deploy/
monitoring/
*.md
CHANGELOG.md
README.md

# Tests — not shipped in the runtime image, with ONE deliberate exception.
#
# app/guardrails/jailbreak.py resolves its semantic corpus to
# <root>/tests/guardrails/adversarial/red_team_prompts.jsonl. Excluding all of
# tests/ meant the deployed image logged `jailbreak_corpus_not_found` and ran
# with `corpus_size=0` — pattern matching (46 patterns) still worked, but the
# semantic tier silently had nothing to compare against, which is a real
# weakening of defence-in-depth on a PUBLIC demo. Caught by reading container
# logs on the first live deploy (2026-07-30).
#
# Docker evaluates .dockerignore per path with last-match-wins, so a `!` line
# after a directory exclusion genuinely re-includes that single file (verified
# with the `pathspec` engine: this file INCLUDED, tests/unit/** and the rest of
# tests/guardrails/** still EXCLUDED).
tests/
!tests/guardrails/adversarial/red_team_prompts.jsonl

# Python / tooling caches
__pycache__/
*.py[codz]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# Virtualenvs
rag_env/
.venv/
venv/

# Host-only provisioning scripts — Dockerfile replicates the needed flags directly
install_cuda.sh
.cuda_compat/
