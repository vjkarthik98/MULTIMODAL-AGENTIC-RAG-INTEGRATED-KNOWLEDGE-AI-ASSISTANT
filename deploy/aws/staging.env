# Committed, non-secret deploy config for the STAGING box — the private,
# no-HTTP, no-Caddy pre-production instance cd.yml's deploy-staging job
# targets. Layered into the container exactly like deploy/aws/prod.env is for
# production (see cd.yml's "Deploy via SSM" step, `--env-file` ordering).
#
# Deliberately NOT identical to prod.env:
#   - No GRAFANA_ROOT_URL — staging has no monitoring stack (Phase 31's
#     docker-compose.monitoring.yml is a production-only deploy).
#   - No CORS_ORIGINS / FRONTEND_URL / OAUTH_REDIRECT_URI pointing at real
#     external hosts — nothing outside this box can ever reach it (no public
#     port, no security-group ingress), so there is no browser origin to
#     allow and no OAuth redirect that could ever be hit.
#
# Deliberately SAME as prod.env: QDRANT_URL / REDIS_URL / VRAM_BUDGET_GB /
# EVAL_USER_ID. Staging evaluates against the real external services
# (Qdrant Cloud, Upstash Redis, MongoDB), isolated by EVAL_USER_ID tenant
# scoping — the same isolation Tier-2 already relies on today. Standing up a
# fully separate Qdrant/Mongo/Redis just for staging was judged out of scope
# for this pipeline; if that ever changes, this is the file to update.

# Nominal card VRAM (48GB) vs. what CUDA actually reports as free once the
# OS/driver take their share — same box class as prod, same real ceiling.
VRAM_BUDGET_GB=44

# Qdrant Cloud / Upstash Redis endpoints — hostnames only, do nothing
# without QDRANT_API_KEY/REDIS_TOKEN (both SSM SecureString, not here).
# Shared with production — see header note above.
QDRANT_URL=https://63deb9a4-9c59-4a5f-8b64-e3a3cecb435d.us-east-1-1.aws.cloud.qdrant.io
REDIS_URL=https://humane-bird-87833.upstash.io

# Gmail account used for outbound OTP/password-reset mail — never actually
# exercised on staging (no public traffic), kept only so app startup config
# validation has a non-empty value to read, matching prod's shape.
SMTP_USER=magikaiassistant@gmail.com

# Opaque UUIDs for data-isolation scoping — not credentials. Same
# EVAL_USER_ID is the DEMO account's tenant (testuser@ragdev.local, see
# config.py's DEMO_ACCOUNT_EMAIL) — that is where the ingested gold corpus
# actually lives (1175 points in text_collection, verified 2026-08-07). It was
# previously 36055d60-… , a tenant with ZERO points, which made Tier-1 rebuild
# an empty BM25 index and correctly refuse to score.
#
# KNOWN TRADEOFF: because this is the public demo login, a visitor can delete
# the corpus through the Knowledge Base panel and Tier-1 will start failing.
# That is accepted deliberately — the gate fails LOUDLY (refuses to score an
# empty index) rather than silently passing, so the blast radius is a red CI
# check, never a regression shipped unnoticed. Recovery is to re-ingest
# data/raw/finance through the demo account.
#
# Same EVAL_USER_ID as production so Tier-2's gold-set queries hit the same
# ingested corpus/tenant on both boxes.
DEFAULT_DEV_USER_ID=eval_default
EVAL_USER_ID=5ead49e7-42f0-4368-80ac-8014595c3980
