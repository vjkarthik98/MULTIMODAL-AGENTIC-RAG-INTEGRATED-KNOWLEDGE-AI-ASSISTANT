https://APP_DOMAIN_PLACEHOLDER {
	# The https:// scheme prefix is REQUIRED, not decorative. A bare hostname
	# here makes Caddy log "listening only on the HTTP port, so no automatic
	# HTTPS will be applied" and it never even attempts the Let's Encrypt
	# request — no error, just silently no port 443 (hit for real, 2026-07-30,
	# setting up magik.vk-ai.online — cost real debugging time before the fix
	# turned out to be this one line). Explicit https:// unambiguously tells
	# Caddy's auto-HTTPS logic this site needs a certificate.
	#
	# flush_interval -1 = flush every write immediately. Without it, Caddy
	# buffers SSE chunks and the chat UI receives the whole streamed answer
	# in one burst at the end instead of token-by-token.
	#
	# Long read/write timeouts: a cold Qwen2.5-14B load can take minutes, and
	# multimodal ingestion (audio/video transcription) runs well past typical
	# proxy defaults. A demo that times out mid-model-load is worse than one
	# that just takes a while.
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
