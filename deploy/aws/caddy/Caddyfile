https://APP_DOMAIN_PLACEHOLDER {
	# The https:// scheme prefix is REQUIRED, not decorative. A bare hostname
	# here makes Caddy log "listening only on the HTTP port, so no automatic
	# HTTPS will be applied" and it never even attempts the Let's Encrypt
	# request — no error, just silently no port 443 (hit for real, 2026-07-30,
	# setting up magik.vk-ai.online — cost real debugging time before the fix
	# turned out to be this one line). Explicit https:// unambiguously tells
	# Caddy's auto-HTTPS logic this site needs a certificate.
	#
	# flush_interval -1 = flush every write immediately. Without it, Caddy
	# buffers SSE chunks and the chat UI receives the whole streamed answer
	# in one burst at the end instead of token-by-token.
	#
	# Long read/write timeouts: a cold Qwen2.5-14B load can take minutes, and
	# multimodal ingestion (audio/video transcription) runs well past typical
	# proxy defaults. A demo that times out mid-model-load is worse than one
	# that just takes a while.
	#
	# NOTE: once Phase 31's /grafana handle block (below) was added, this had
	# to move into its own `handle {}` too — Caddy's docs warn against mixing
	# bare top-level directives with handle blocks in the same server block
	# (unpredictable evaluation order). `handle` blocks are evaluated in
	# order, first match wins; the bare `handle {}` below matches everything
	# /grafana/* didn't.
	handle /grafana/* {
		# Phase 31 — Grafana, gated behind Caddy basic_auth. This is CRITICAL,
		# not optional: an open Grafana on the public app subdomain leaks
		# internal metrics, traces, and error payloads (query latencies, user
		# counts, circuit-breaker state) to anyone who finds the URL.
		# Grafana's own GF_SECURITY_ADMIN_PASSWORD
		# (docker-compose.monitoring.yml) is defense in depth, not a
		# substitute for this gate — don't skip it because Grafana "also" has
		# a login screen.
		#
		# GRAFANA_BASICAUTH_HASH_PLACEHOLDER: generate with
		#   docker run --rm caddy:2 caddy hash-password --plaintext '<your password>'
		# and substitute the bcrypt hash below before deploy — same
		# placeholder convention as APP_DOMAIN_PLACEHOLDER above (both
		# hand-replaced, not templated at runtime).
		#
		# handle (not handle_path): Grafana's GF_SERVER_SERVE_FROM_SUB_PATH=true
		# (docker-compose.monitoring.yml) expects the /grafana prefix
		# preserved on the forwarded request, not stripped — handle_path
		# would break asset URLs and redirects.
		basic_auth {
			admin GRAFANA_BASICAUTH_HASH_PLACEHOLDER
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# A cold start (instance start -> container up -> models verified -> LLM
	# loaded) takes ~7 minutes, and for that whole window the upstream on :8000
	# refuses connections, so Caddy's default was a bare "502 Bad Gateway" —
	# indistinguishable from a broken deploy. During a live interview on
	# 2026-10-02 that raw error read as "the site is dead", and the instance was
	# stopped mid-boot, which restarted the whole 7 minutes. Say what is
	# actually happening and retry on its own. Only upstream-unavailable
	# statuses are covered; real app errors (500, 4xx) still pass through.
	handle_errors {
		@upstream_down expression {err.status_code} in [502, 503, 504]
		handle @upstream_down {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			header Retry-After "20"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="15"><title>MAGIK AI is starting</title><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:system-ui,sans-serif;background:#0f1115;color:#e8eaf0}main{max-width:30rem;padding:2rem;text-align:center}h1{font-size:1.4rem;margin:0 0 .75rem}p{line-height:1.5;color:#aab0c0;margin:.5rem 0}</style></head><body><main><h1>MAGIK AI is starting up</h1><p>The server is loading its models. After a cold start this takes about 7 minutes.</p><p>This page refreshes by itself every 15 seconds. Please do not stop the instance while it loads.</p></main></body></html>` 503
		}
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# No `log { output file ... }` block on purpose. Caddy's default access
	# logging already goes to stdout -> journald, readable with
	# `journalctl -u caddy`. Adding a file output here broke every reload on
	# the g6e box with "open /var/log/caddy/access.log: permission denied",
	# and the reload failing left the OLD config live while `systemctl reload`
	# still exited 0 — a silent no-op that is genuinely hard to spot. The
	# directory was already owned caddy:caddy and the unit only sets
	# ProtectSystem=full (which does not cover /var/log), so the cause is
	# most likely an AppArmor profile; it was never root-caused because
	# journald logging is sufficient here. If you re-add file logging, verify
	# the running config afterwards via the admin API rather than trusting
	# the exit code:
	#   sudo curl -s localhost:2019/config/ | head -c 2000
}
