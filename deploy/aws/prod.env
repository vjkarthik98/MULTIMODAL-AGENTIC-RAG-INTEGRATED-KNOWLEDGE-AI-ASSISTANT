# Committed, non-secret deploy config for the production box.
#
# Closes half of the v0.28.0 Known Issue: GRAFANA_ROOT_URL was added by hand
# directly to /opt/magik/.env during live debugging (see CHANGELOG.md "Fixed
# — monitoring stack, found live on the box post-deploy"), and VRAM_BUDGET_GB
# was corrected in .env.example/config.py's documented default but never
# actually updated on the box itself (still 46, not 44). Both are non-secret,
# environment-specific config — exactly what CLAUDE.md's Config section says
# belongs in a committed env file, not in SSM (which is for real secrets)
# and not hardcoded into app defaults (which would need a code change +
# redeploy just to retune a single box's VRAM headroom).
#
# NTFY_WEBHOOK_URL is deliberately NOT here, despite being hand-added at the
# same time as GRAFANA_ROOT_URL — per the agreed secrets-migration plan
# (project memory "secrets-management-gap", 2026-07-31), it's a SECRET: ntfy
# topics are unauthenticated by default, so knowing the URL IS having access
# (post fake alerts, or silently read real ones). This repo is public —
# committing it here would permanently expose it in git history. It goes to
# SSM instead, alongside GRAFANA_ADMIN_PASSWORD and the other real secrets.
#
# Below GRAFANA_ROOT_URL/VRAM_BUDGET_GB, this file also picks up the rest of
# .env.example's SECRETS section that turned out not to be secrets at all —
# audited 2026-08-01 against the real values already hand-set in
# /opt/magik/.env: QDRANT_URL/REDIS_URL are endpoint hostnames, inert
# without their paired key/token (both now in SSM, see deploy/aws/README.md
# "App secrets in SSM"); GOOGLE_CLIENT_ID is public by OAuth design, only
# GOOGLE_CLIENT_SECRET (in SSM) is confidential; OAUTH_REDIRECT_URI/
# FRONTEND_URL/CORS_ORIGINS/SMTP_USER/DEFAULT_DEV_USER_ID/EVAL_USER_ID are
# all either plain URLs matching this domain or opaque, non-sensitive
# identifiers.
#
# This file is layered into the container the same way as the SSM-sourced
# secrets file — see cd.yml's "Deploy via SSM" step, `--env-file` ordering
# (later wins). Editing this file and pushing a new tag is now the only way
# to change any of these values; do not hand-edit /opt/magik/.env for them
# again, or this file silently stops being the source of truth.

# Grafana's own HTTP server has no way to know Caddy terminates TLS on the
# real hostname in front of it — GF_SERVER_ROOT_URL must be the actual
# external URL, or the post-login redirect breaks (see the v0.28.0 fix).
GRAFANA_ROOT_URL=https://magik.vk-ai.online/grafana/

# Nominal card VRAM (48GB) vs. what CUDA actually reports as free once the
# OS/driver take their share (~44.4GB, confirmed live via device_manager's
# own startup log on the g6e.xlarge L40S). device_manager.py does
# min(actual_free_vram, VRAM_BUDGET_GB) — any value above the real total is
# a silent no-op, so this must stay at or below the real ceiling to mean
# anything at all.
VRAM_BUDGET_GB=44

# Qdrant Cloud / Upstash Redis endpoints — hostnames only, do nothing
# without QDRANT_API_KEY/REDIS_TOKEN (both SSM SecureString, not here).
QDRANT_URL=https://63deb9a4-9c59-4a5f-8b64-e3a3cecb435d.us-east-1-1.aws.cloud.qdrant.io
REDIS_URL=https://humane-bird-87833.upstash.io

# Google OAuth2 "Sign in with Google" — public client ID, not a secret.
GOOGLE_CLIENT_ID=416668181176-qbcdenhimq9oce7mvhn1hjbbrvh72963.apps.googleusercontent.com
OAUTH_REDIRECT_URI=https://magik.vk-ai.online/auth/callback/google
FRONTEND_URL=https://magik.vk-ai.online

# Gmail account used for outbound OTP/password-reset mail — the address
# itself isn't a credential (SMTP_PASSWORD, in SSM, is).
SMTP_USER=magikaiassistant@gmail.com

# Real production frontend origins allowed to call the API cross-origin.
CORS_ORIGINS=https://vk-ai-pi.vercel.app,https://vk-ai.online,https://magik.vk-ai.online

# Opaque UUIDs for data-isolation scoping — not credentials, just which
# tenant the eval harness / dev tooling operates as on this box.
DEFAULT_DEV_USER_ID=eval_default
EVAL_USER_ID=36055d60-9099-4f51-81d2-08fe33916356
