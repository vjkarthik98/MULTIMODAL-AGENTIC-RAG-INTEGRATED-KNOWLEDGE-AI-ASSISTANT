# Committed, non-secret deploy config for the production box.
#
# Closes half of the v0.28.0 Known Issue: GRAFANA_ROOT_URL was added by hand
# directly to /opt/magik/.env during live debugging (see CHANGELOG.md "Fixed
# — monitoring stack, found live on the box post-deploy"), and VRAM_BUDGET_GB
# was corrected in .env.example/config.py's documented default but never
# actually updated on the box itself (still 46, not 44). Both are non-secret,
# environment-specific config — exactly what CLAUDE.md's Config section says
# belongs in a committed env file, not in SSM (which is for real secrets)
# and not hardcoded into app defaults (which would need a code change +
# redeploy just to retune a single box's VRAM headroom).
#
# NTFY_WEBHOOK_URL is deliberately NOT here, despite being hand-added at the
# same time as GRAFANA_ROOT_URL — per the agreed secrets-migration plan
# (project memory "secrets-management-gap", 2026-07-31), it's a SECRET: ntfy
# topics are unauthenticated by default, so knowing the URL IS having access
# (post fake alerts, or silently read real ones). This repo is public —
# committing it here would permanently expose it in git history. It goes to
# SSM instead, alongside GRAFANA_ADMIN_PASSWORD and the other real secrets.
#
# Below GRAFANA_ROOT_URL/VRAM_BUDGET_GB, this file also picks up the rest of
# .env.example's SECRETS section that turned out not to be secrets at all —
# audited 2026-08-01 against the real values already hand-set in
# /opt/magik/.env: QDRANT_URL/REDIS_URL are endpoint hostnames, inert
# without their paired key/token (both now in SSM, see deploy/aws/README.md
# "App secrets in SSM"); GOOGLE_CLIENT_ID is public by OAuth design, only
# GOOGLE_CLIENT_SECRET (in SSM) is confidential; OAUTH_REDIRECT_URI/
# FRONTEND_URL/CORS_ORIGINS/SMTP_USER/DEFAULT_DEV_USER_ID/EVAL_USER_ID are
# all either plain URLs matching this domain or opaque, non-sensitive
# identifiers.
#
# This file is layered into the container the same way as the SSM-sourced
# secrets file — see cd.yml's "Deploy via SSM" step, `--env-file` ordering
# (later wins). Editing this file and pushing a new tag is now the only way
# to change any of these values; do not hand-edit /opt/magik/.env for them
# again, or this file silently stops being the source of truth.

# Grafana's own HTTP server has no way to know Caddy terminates TLS on the
# real hostname in front of it — GF_SERVER_ROOT_URL must be the actual
# external URL, or the post-login redirect breaks (see the v0.28.0 fix).
GRAFANA_ROOT_URL=https://magik.vk-ai.online/grafana/

# Turn on the app-side half of the monitoring stack. All four default OFF
# (app/core/config.py) so local/CI runs never pay the cost or need a
# collector — production is the one place the monitoring/ stack (Phase 31)
# actually exists to receive this. Without these, magik-current never opens
# :9464 for Prometheus to scrape and never emits an OTLP span, so
# monitoring/prometheus/prometheus.yml's magik-current target and every
# Grafana dashboard/alert reading magik_* metrics stay permanently empty —
# not an error, just silent absence of data.
PROMETHEUS_ENABLED=true
OTEL_ENABLED=true
# otel-collector's OTLP gRPC receiver, reached by its magik-net service name
# (see docker-compose.monitoring.yml / monitoring/otel/collector-config.yaml)
# — magik-current joins the same external magik-net network in cd.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_JSON=true

# Online eval (Phase 31): both default OFF/0.0 in app/core/config.py, so this
# box was silently never sampling live traffic into MONGO_EVAL_SHADOW_COLLECTION
# and app/eval/jobs/online_eval.py's background loop never had rows to score —
# the magik_eval_online_* Grafana gauges stayed at Prometheus's own 0.0 default
# forever, which reads identically to "measured zero" on a dashboard (found
# 2026-08-21: Grafana "Logs"/"System health" panels had data, "RAG quality" did
# not; magik_verification_* per-request metrics already had 13 real samples,
# proving traffic was flowing — only the shadow-sampling side was off).
# 1.0 (sample everything) is deliberate given this box's real traffic volume is
# low (portfolio-demo scale, not high-QPS production) — anything lower risks
# still having too few sampled rows to populate the dashboard meaningfully.
# Revisit downward if/when real query volume grows enough that 100% sampling
# adds noticeable load on Mongo Atlas.
ONLINE_EVAL_ENABLED=true
ONLINE_EVAL_SAMPLE_RATE=1.0

# Pre-deploy config audit (2026-08-21): all four below default OFF/unset in
# app/core/config.py and were never overridden here, so production has been
# running an unvalidated/less-hardened config on each of these axes.

# Real BitsAndBytes 8-bit quantization at load time (model_loader.py:836), not
# just a model-name choice. The image-modality accuracy benchmark (~95+ avg,
# aapl-20240928_g2.jpg) was run against "Qwen2-VL 7B INT8" — without this flag,
# production loads full float16 instead, an unvalidated config. INT8 also
# lowers the load-time CPU-RAM footprint, which matters given this box's
# documented swap-thrashing history loading this exact model (see
# model_loader.py's load_kwargs comment).
QWEN2_VL_LOAD_IN_8BIT=true

# Redacts PERSON/EMAIL_ADDRESS/PHONE_NUMBER/US_SSN/CREDIT_CARD (Presidio,
# already in requirements.txt — not a silent no-op) before ingestion storage
# and before conversation history is sent to the LLM for summarization. Public
# demo login means visitors' real PII could otherwise sit unredacted in
# Mongo/Qdrant and get sent raw to the LLM.
PII_DETECTION_ENABLED=true

# Strips GPS EXIF data from uploaded images instead of storing it — low-risk
# privacy hardening for public uploads.
IMAGE_PRIVACY_MODE=true

# Fail fast at startup if .hf_cache/download_manifest.json is missing, instead
# of failing weirdly downstream. Confirmed real: app/bin/models/
# download_all_models.py actually writes this manifest on every model
# download, so requiring it here is safe, not speculative.
MODEL_CACHE_REQUIRE_MANIFEST=true

# Nominal card VRAM (48GB) vs. what CUDA actually reports as free once the
# OS/driver take their share (~44.4GB, confirmed live via device_manager's
# own startup log on the g6e.xlarge L40S). device_manager.py does
# min(actual_free_vram, VRAM_BUDGET_GB) — any value above the real total is
# a silent no-op, so this must stay at or below the real ceiling to mean
# anything at all.
VRAM_BUDGET_GB=44

# Qdrant Cloud / Upstash Redis endpoints — hostnames only, do nothing
# without QDRANT_API_KEY/REDIS_TOKEN (both SSM SecureString, not here).
QDRANT_URL=https://63deb9a4-9c59-4a5f-8b64-e3a3cecb435d.us-east-1-1.aws.cloud.qdrant.io
REDIS_URL=https://humane-bird-87833.upstash.io

# Google OAuth2 "Sign in with Google" — public client ID, not a secret.
GOOGLE_CLIENT_ID=416668181176-qbcdenhimq9oce7mvhn1hjbbrvh72963.apps.googleusercontent.com
OAUTH_REDIRECT_URI=https://magik.vk-ai.online/auth/callback/google
FRONTEND_URL=https://magik.vk-ai.online

# Gmail account used for outbound OTP/password-reset mail — the address
# itself isn't a credential (SMTP_PASSWORD, in SSM, is).
SMTP_USER=magikaiassistant@gmail.com

# Real production frontend origins allowed to call the API cross-origin.
CORS_ORIGINS=https://vk-ai-pi.vercel.app,https://vk-ai.online,https://magik.vk-ai.online

# Opaque UUIDs for data-isolation scoping — not credentials, just which
# tenant the eval harness / dev tooling operates as on this box.
DEFAULT_DEV_USER_ID=eval_default
EVAL_USER_ID=5ead49e7-42f0-4368-80ac-8014595c3980

# Stated explicitly rather than inherited. Production was ALSO relying on
# whatever /opt/magik/.env happened to contain — an unversioned, hand-written
# file on the box — for the value that gates /docs+/redoc exposure
# (app/main.py) and labels every structured log line. It happened to be right,
# but nothing in the repo guaranteed it, and staging is the proof of how that
# fails: it inherited this same value from a disk clone and wrongly reported
# itself as production. Declaring it here makes the value reviewable, and
# makes the staging/production distinction real rather than incidental.
ENV=production
