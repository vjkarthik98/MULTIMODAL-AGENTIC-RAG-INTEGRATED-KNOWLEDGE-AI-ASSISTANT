# ==============================================================================
# .env.example — SECRETS + PER-ENVIRONMENT / PER-HARDWARE OVERRIDES ONLY.
# Copy to .env and fill in the secrets below.
#
# Every other setting (chunk sizes, retrieval weights, timeouts, model names,
# feature flags, etc.) has a hardcoded, production-tuned default in
# app/core/config.py (the Settings class) and does NOT belong here. Only add a
# line if it's a credential, or a value that genuinely differs between
# machines/deployments (dev vs prod, CPU laptop vs GPU box, which account owns
# the loaded KB, CORS origins, etc). If you need to override one of the
# defaults in config.py for your environment, add it here — the env var will
# take precedence.
# ==============================================================================


# ── ENVIRONMENT ────────────────────────────────────────────────────────────────
ENV=development
DEBUG=false

# ── HARDWARE PROFILE — leave everything below unset to let device_manager
# auto-detect CUDA vs CPU. Pin explicit values only if you need to force a
# device (e.g. a CPU-only dev machine, to silence device-demotion log spam) or
# match a specific deployment profile (AWS g5.xlarge A10G = all_gpu). ────────
# MODELS_DEVICE_PROFILE=all_gpu
# EMBEDDER_DEVICE=cpu
# RERANKER_DEVICE=cpu
# SIGLIP_DEVICE=cpu
# BLIP_DEVICE=cpu
# WHISPER_DEVICE=cpu
# LLM_DEVICE_HINT=cpu
# QWEN2_VL_DEVICE=cpu
# TROCR_DEVICE=cpu
# DIARIZER_DEVICE=cpu
# NER_DEVICE=cpu

# CPU inference is slower than a GPU deployment — widen these if running on CPU.
# REQUEST_TIMEOUT_SEC=300
# MODEL_TIMEOUT_SEC=300
# LLM_CALL_TIMEOUT_SEC=120

# ── DEV-ONLY FLAGS ─────────────────────────────────────────────────────────────
# DEV_OTP_LOG=true → prints OTP/reset links to server console, skips SMTP (dev only)
DEV_OTP_LOG=false

# CORS allowed origins (comma-separated) — set to your real frontend origin(s) in production
CORS_ORIGINS=http://localhost:7860,http://localhost:8000

# ── DEPLOYMENT/DATA IDENTITY ───────────────────────────────────────────────────
# Opaque UUID/dev user_id for data isolation in Qdrant, BM25, Redis, Mongo
DEFAULT_DEV_USER_ID=
# Eval harness: run as the account that owns the loaded KB
EVAL_USER_ID=


# ==============================================================================
# SECRETS — fill in your own; never commit real values; rotate immediately if exposed
# ==============================================================================

# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=

# Upstash Redis (REST)
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=

# MongoDB Atlas connection string (contains credentials)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0

# HuggingFace token — pyannote.audio model access + GGUF model access
# Get one at huggingface.co/settings/tokens
HF_TOKEN=

# Session/JWT signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value. NEVER use this placeholder in production.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# Google OAuth2 — "Sign in with Google" (leave blank to disable)
# Get these from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP — OTP + password reset
SMTP_USER=
SMTP_PASSWORD=

# Tavily web search
TAVILY_API_KEY=

# Optional — leave blank unless you use these
COHERE_API_KEY=
SERPAPI_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
