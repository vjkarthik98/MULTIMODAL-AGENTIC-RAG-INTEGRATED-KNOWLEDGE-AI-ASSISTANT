# ==============================================================================
# CORE APPLICATION
# ==============================================================================

APP_NAME="Multimodal RAG Agentic Knowledge AI Assistant"
APP_VERSION="0.20.0"
APP_DESCRIPTION="Production Multimodal RAG + Agentic AI System"

# ENV: development | staging | production
ENV=development

# Enable debug logs — set false in production
DEBUG=false

# Server binding — use 127.0.0.1 for local dev, 0.0.0.0 for container
HOST=127.0.0.1
PORT=8000


# ==============================================================================
# PATHS
# ==============================================================================

# Root data directory (mounted volume in Docker)
DATA_DIR=./data

# Log output directory
LOG_DIR=./logs

# Directory for temporarily staging uploaded files during validation
UPLOAD_STAGING_DIR=./data/staging

# Directory for extracted video frames (cleaned up after ingestion)
VIDEO_FRAMES_DIR=./data/temp_frames

# Directory for images extracted from PDFs
PDF_IMAGE_DIR=./data/images

# Root directory for Phase 24 test fixtures
TEST_FIXTURES_DIR=./tests/fixtures/phase24

# Temp file base dir (auto-purged after every pipeline run)
TEMP_DIR=./data/temp


# ==============================================================================
# LOGGING — structlog / loguru JSON-structured with correlation IDs
# ==============================================================================

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Use structured JSON logs (true in production, false for local readability)
LOG_JSON=false

# Include timestamps in console output
LOG_SHOW_TIMESTAMP=true

# Enable rotating file log
ENABLE_FILE_LOGGING=true
LOG_FILE_NAME=app.log

# Rotating file handler: 10MB per file, keep 5 backups
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Correlation ID header name (injected per request for distributed tracing)
CORRELATION_ID_HEADER=X-Correlation-ID


# ==============================================================================
# OPENTELEMETRY — Spans on every public method + pipeline stage
# ==============================================================================

# OTLP gRPC endpoint (e.g. Jaeger, Tempo, Honeycomb)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service name tag
OTEL_SERVICE_NAME=multimodal-rag-assistant

# Enable OpenTelemetry tracing (false = no-op)
OTEL_ENABLED=false

# Sampling ratio: 1.0 = trace every request; 0.1 = 10%
OTEL_SAMPLING_RATIO=1.0


# ==============================================================================
# PROMETHEUS METRICS
# file_ingestion_duration_seconds, file_ingestion_errors_total,
# chunk_count_per_file, embedding_latency_seconds,
# retrieval_latency_seconds, llm_call_latency_seconds,
# pii_entities_redacted_total, queue_depth, circuit_breaker_state
# ==============================================================================

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Expose /metrics endpoint (requires prometheus_client installed)
PROMETHEUS_METRICS_PATH=/metrics


# ==============================================================================
# PERFORMANCE & CONCURRENCY
# ==============================================================================

# Thread pool for sync-to-async bridging (Whisper, BLIP, Tesseract)
THREAD_POOL_SIZE=4

# asyncio.Semaphore cap per processor (default 5 workers per)
ASYNC_SEMAPHORE_WORKERS=5

# Max simultaneous FastAPI requests in flight
MAX_PARALLEL_REQUESTS=20

# HTTP request timeout (entire request lifecycle)
REQUEST_TIMEOUT_SEC=120

# Hard kill per file: 120 s; per LLM call: 30 s 
FILE_PROCESSING_TIMEOUT_SEC=120
LLM_CALL_TIMEOUT_SEC=30

# Qdrant retrieval timeout
RETRIEVAL_TIMEOUT=10

# Embedding model inference timeout
EMBEDDING_TIMEOUT=15

# Qdrant client-level timeout
VECTOR_DB_TIMEOUT=10

# LLM inference timeout (Mistral 7B Q4 on CPU can be slow on long prompts)
MODEL_TIMEOUT_SEC=120

# Requests exceeding this threshold are logged as slow
SLOW_REQUEST_THRESHOLD=3.0

# Ingestion async queue worker count
INGESTION_WORKER_COUNT=3


# ==============================================================================
# LLM — Mistral 7B Instruct v0.2 Q4_K_M (GGUF / llama-cpp-python)
# Fallback chain: primary LLM → local GGUF → error response
# ==============================================================================

# Absolute path to the GGUF model file
LLM_MODEL_PATH=./models/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Max tokens to generate per completion
LLM_MAX_TOKENS=512

# Context window size (Mistral supports 4096)
CONTEXT_MAX_TOKENS=4096

# Sampling temperature — 0.0 for deterministic RAG answers
LLM_TEMPERATURE=0.2

# Top-p nucleus sampling
LLM_TOP_P=0.9

# Max characters accepted in a single prompt string (safety guard)
MAX_PROMPT_CHARS=8000

# GPU offload layers — 0 for CPU-only
LLM_GPU_LAYERS=0

# llama-cpp threads
LLM_THREADS=8

# Batch size for llama-cpp prompt processing
LLM_N_BATCH=512

# Tenacity retry settings for LLM calls
LLM_MAX_RETRIES=3
LLM_RETRY_WAIT_MIN=1
LLM_RETRY_WAIT_MAX=10


# ==============================================================================
# EMBEDDINGS — Multi-model: OpenAI / BGE-M3 / MiniLM
# Sparse + Dense fusion; Matryoshka 256-dim + 1536-dim
# Redis embedding cache keyed by chunk SHA-256; TTL 30 days
# ==============================================================================

# Primary text embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Batch size for embedding (32 optimal for CPU RAM)
EMBEDDING_BATCH_SIZE=32

# Max chunks per embedding batch
EMBEDDING_MAX_BATCH_SIZE=100

# Redis TTL for cached embeddings: 30 days (per Section 4.3)
EMBEDDING_CACHE_TTL=2592000

# Output dimension of text embedding model
TEXT_EMBEDDING_DIM=384

# Matryoshka short dimension
MATRYOSHKA_SHORT_DIM=256

# Matryoshka long dimension
MATRYOSHKA_LONG_DIM=1536


# ==============================================================================
# VISION MODELS
# ==============================================================================

# CLIP model for cross-modal (image ↔ text) embedding
CLIP_MODEL=openai/clip-vit-base-patch32

# CLIP embedding dimension (must match Qdrant vision collection)
VISION_EMBEDDING_DIM=512

# BLIP model for image captioning
BLIP_MODEL=Salesforce/blip-image-captioning-base

# BLIP generation parameters
BLIP_MAX_TOKENS=64
BLIP_NUM_BEAMS=3

# Max image dimension before resize (larger = slower OCR/caption on CPU)
MAX_IMAGE_DIM=1024

# Max image file size for processing (50 MP guard)
MAX_IMAGE_SIZE_MP=50

# Thumbnail dimensions for preview storage
THUMBNAIL_WIDTH=256
THUMBNAIL_HEIGHT=256

# Privacy mode: strip GPS EXIF coordinates when true
IMAGE_PRIVACY_MODE=false

# Solid-color image detection threshold (flag as low-content)
SOLID_COLOR_THRESHOLD=0.95


# ==============================================================================
# ASR — Whisper large-v3 (faster-whisper)
# Speaker diarization: pyannote.audio 3.x
# ==============================================================================

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# Audio sample rate (must match Whisper expectation — 16kHz)
AUDIO_SAMPLE_RATE=16000

# Max audio file duration to process (seconds) — > 3h chunked in 30-min segments
MAX_AUDIO_DURATION_SEC=10800

# Max video duration (seconds)
MAX_VIDEO_DURATION_SEC=7200

# SNR threshold below which audio is flagged as noisy (dB)
AUDIO_SNR_THRESHOLD_DB=10.0

# Silence gap duration to flag as dropout (ms)
AUDIO_SILENCE_GAP_MS=200

# Max audio segments to process (safety against very long files)
MAX_AUDIO_SEGMENTS=500

# Parallel chunk duration for long audio (30-min segments)
AUDIO_CHUNK_DURATION_SEC=1800

# Enable speaker diarization (requires pyannote.audio + HuggingFace token)
DIARIZATION_ENABLED=false

# HuggingFace token for pyannote.audio model access
HF_TOKEN=

# Whisper domain vocabulary boost — RAG/ML technical terms
WHISPER_DOMAIN_VOCAB=RAG,FAISS,Qdrant,LlamaIndex,LangChain,RAGAS,Pinecone,ChromaDB,Mistral,OpenAI,Anthropic,embedding,retrieval,chunking,reranker,BM25,cosine,upsert

# Filler words to strip from transcripts
WHISPER_FILLER_WORDS=uh,um,er,hmm


# ==============================================================================
# RERANKER — cross-encoder/ms-marco-MiniLM-L-6-v2 or Cohere rerank
# ==============================================================================

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Reranking parameters
RERANK_TOP_K=5
RERANK_MAX_INPUT=20
RERANK_CONTEXT_MAX_CHARS=512

# Score weights for final ranking
RERANK_MODEL_WEIGHT=0.5
RERANK_FUSION_WEIGHT=0.5
RERANK_POSITION_WEIGHT=0.1

# Cohere reranker API key (optional — uses local cross-encoder if empty)
COHERE_API_KEY=


# ==============================================================================
# QDRANT — Vector Store
# Namespace isolation: per user/project/modality collection
# Circuit breaker: pybreaker on all Qdrant calls
# Upsert idempotency: deterministic vector ID = file_id + chunk_index
# ==============================================================================

# Cloud endpoint
QDRANT_URL=qdrant_url

# Cloud API key
QDRANT_API_KEY=qdrant_api_key
# Local fallback
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Client-level timeout (seconds)
QDRANT_TIMEOUT=10

# Collection names (runtime prepends user_{user_id}_)
TEXT_COLLECTION_NAME=text_collection
VISION_COLLECTION_NAME=vision_collection
COLLECTION_NAME=rag_collection

# Batch size for Qdrant upsert (100 vectors per batch per Section 4.4)
QDRANT_BATCH_SIZE=100

# Safety cap on total documents per collection
QDRANT_MAX_DOCS=100000

# Allow collection recreation on dimension mismatch (dev only)
QDRANT_ALLOW_RECREATE=false

# Retry settings for Qdrant init
QDRANT_INIT_RETRIES=3
QDRANT_RETRY_DELAY=2

# Max characters to store in Qdrant payload text field
QDRANT_TEXT_MAX_CHARS=2000

# Soft-delete: mark deleted_at instead of hard delete
QDRANT_SOFT_DELETE=true

# pybreaker circuit breaker thresholds for Qdrant
QDRANT_CB_FAIL_MAX=5
QDRANT_CB_RESET_TIMEOUT=60


# ==============================================================================
# REDIS — Short-term memory + embedding cache + query result cache
# Circuit breaker + retry on all Redis failures
# GDPR: purge all user memory by user_id
# ==============================================================================

# Upstash REST URL (preferred for cloud)
REDIS_URL=redis_url

# Upstash REST token
REDIS_TOKEN=redis_api_key

# Local fallback
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Connection timeout (seconds)
REDIS_TIMEOUT=5

# Default TTL for cached responses (24 hours)
REDIS_TTL_SECONDS=86400

# TTL for query result cache (1 hour)
REDIS_QUERY_CACHE_TTL=3600

# TTL for embedding cache (30 days per Section 4.3)
REDIS_EMBEDDING_CACHE_TTL=2592000

# Key namespace prefix
REDIS_KEY_PREFIX=rag

# Enable Redis (false = in-memory LRU fallback)
USE_REDIS=false

# pybreaker circuit breaker thresholds for Redis
REDIS_CB_FAIL_MAX=5
REDIS_CB_RESET_TIMEOUT=30

# Max conversation window turns in Redis
REDIS_MAX_WINDOW_TURNS=40


# ==============================================================================
# MONGODB — Long-term episodic memory + audit log + session summaries
# Indexed by user_id + session_id
# Circuit breaker + retry on all MongoDB failures
# ==============================================================================
 # mongodb://localhost:27017
# Atlas connection string
MONGO_URI=mongo_uri

# Database name
MONGO_DB_NAME=rag_memory

# Server selection timeout (ms)
DB_TIMEOUT_MS=5000

# Connection pool size
DB_MAX_POOL_SIZE=20

# pybreaker circuit breaker thresholds for MongoDB
MONGO_CB_FAIL_MAX=5
MONGO_CB_RESET_TIMEOUT=60

# Collections
MONGO_MESSAGES_COLLECTION=messages
MONGO_SUMMARIES_COLLECTION=summaries
MONGO_AUDIT_COLLECTION=audit_log


# ==============================================================================
# CHUNKING — Hierarchical: document → section → paragraph → sentence
# Parent-child linking; cross-modal linking; token-aware overlap
# Near-dedup via MinHash at chunk level
# ==============================================================================

# Chunk size in characters
CHUNK_SIZE=512

# Overlap between consecutive chunks
CHUNK_OVERLAP=50

# Overlap ratio (15% default per Section 4.1)
CHUNK_OVERLAP_RATIO=0.15

# Minimum chunk length to keep
CHUNK_MIN_SIZE=50

# Hard cap on chunks per document
MAX_CHUNKS=200

# Ingestion batch size
INGESTION_BATCH_SIZE=32

# Token-aware chunking: max tokens per chunk (tiktoken)
CHUNK_MAX_TOKENS=512

# MinHash near-dedup threshold (0.0–1.0; lower = stricter dedup)
CHUNK_MINHASH_THRESHOLD=0.85

# MinHash number of permutations
CHUNK_MINHASH_PERMUTATIONS=128

# Adaptive chunking: shorter for dense technical content
CHUNK_ADAPTIVE_ENABLED=true

# Late chunking support (embed full doc first; chunk post-embedding)
LATE_CHUNKING_ENABLED=false


# ==============================================================================
# BM25 RETRIEVAL — Persisted at data/bm25_index/bm25_index.pkl
# ==============================================================================

BM25_MAX_DOCS=10000
BM25_TOP_K=10
BM25_MIN_SCORE=0.1
BM25_MAX_TEXT_CHARS=1000
BM25_MAX_TOKENS=256


# ==============================================================================
# HYBRID RETRIEVAL — RRF (Reciprocal Rank Fusion) dense + sparse
# MMR diversity: Maximal Marginal Relevance
# ==============================================================================

HYBRID_WEIGHT_BM25=0.4
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_VISION=0.2

# Retrieve N× top_k candidates before fusion
HYBRID_CANDIDATES_MULTIPLIER=3
HYBRID_MIN_SCORE=0.05

# RRF rank constant (k=60 standard)
HYBRID_RRF_K=60

# MMR lambda: 1.0 = pure relevance, 0.0 = pure diversity
HYBRID_MMR_LAMBDA=0.7

# Score threshold: discard chunks below this similarity
HYBRID_SCORE_THRESHOLD=0.1


# ==============================================================================
# RESULT FUSION
# ==============================================================================

FUSION_SIMILARITY_THRESHOLD=0.7
FUSION_SCORE_WEIGHT=0.6
FUSION_QUALITY_WEIGHT=0.2
FUSION_MODALITY_WEIGHT=0.2
FUSION_MAX_INPUT=30
FUSION_MAX_TEXT_CHARS=1200
FUSION_MIN_SCORE=0.05


# ==============================================================================
# RAG RETRIEVAL
# ==============================================================================

DEFAULT_TOP_K=5
VECTOR_TOP_K=10
MAX_CONTEXT_DOCS=5
MAX_CONTEXT_CHARS=4000

RAG_TOP_K=5
RAG_DOC_MAX_CHARS=1200


# ==============================================================================
# QUERY DECOMPOSITION — Multi-hop question splitting
# Query types: factual | comparative | temporal | aggregation
# ==============================================================================

MAX_SUBQUERIES=3
SUBQUERY_MAX_TOKENS=64
DECOMPOSITION_MIN_WORDS=6
DECOMPOSITION_MAX_SUBQUERIES=3
DECOMPOSITION_CONFIDENCE_THRESHOLD=0.5


# ==============================================================================
# WEB SEARCH — Tavily / SerpAPI
# Result dedup + ranking; SSRF prevention via URL allowlist
# ==============================================================================

# NEVER commit this key — rotate immediately if exposed
TAVILY_API_KEY=tavily_api_key

# SerpAPI key (optional fallback)
SERPAPI_KEY=

WEB_MAX_DOCS=5
WEB_MAX_RESULTS=10
WEB_DOC_MAX_CHARS=1000
WEB_CONTEXT_MAX_CHARS=4000

# Search depth: basic | advanced
WEB_SEARCH_DEPTH=advanced

# Block private IP ranges (SSRF prevention — RFC1918)
WEB_SEARCH_BLOCK_PRIVATE_IPS=true

# URL allowlist for web search (comma-separated domains; empty = allow all)
WEB_SEARCH_DOMAIN_ALLOWLIST=


# ==============================================================================
# MEMORY — Redis (short-term) + MongoDB (long-term episodic)
# GDPR purge: all user memory deletable by user_id
# ==============================================================================

MAX_HISTORY_MESSAGES=40
MAX_SYSTEM_MESSAGES=5

MEMORY_TOP_K=5
MEMORY_MAX_CONTEXT_CHARS=2000
MEMORY_SIM_THRESHOLD=0.3
MEMORY_RECENCY_SCALE=3600

MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_SUMMARY_INPUT_CHARS=4000
MIN_SUMMARY_LENGTH=50

# Sliding window memory max tokens (per session)
SLIDING_WINDOW_MAX_TOKENS=4096


# ==============================================================================
# AGENT — ReAct loop; parallel tool execution via asyncio.gather
# Hard kill after max_seconds; Pydantic schemas for all I/O
# ==============================================================================

AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SEC=60
AGENT_STEP_TIMEOUT_SEC=30
AGENT_HIGH_CONFIDENCE=0.7
AGENT_LOW_CONFIDENCE=0.4
AGENT_TOOL_TIMEOUT=30
AGENT_MAX_RETRIES=3
AGENT_ENABLE_DECOMPOSITION=true
AGENT_QUERY_EXPANSION_ENABLED=true

# Max agent loop iterations guard
AGENT_MAX_ITERATIONS=20

# Parallel tool execution (asyncio.gather)
AGENT_PARALLEL_TOOLS=true


# ==============================================================================
# FILE UPLOAD — Per-modality size limits (bytes)
# Magic-byte MIME detection — never trust extension
# SHA-256 dedup before processing
# Malware scan: ClamAV on every upload
# Encryption at rest: AES-256 for temp files
# ==============================================================================

# Max text file size: 10MB
MAX_FILE_SIZE_TEXT=10485760

# Max PDF size: 100MB
MAX_FILE_SIZE_PDF=104857600

# Max DOCX size: 50MB
MAX_FILE_SIZE_DOCX=52428800

# Max XLSX size: 50MB
MAX_FILE_SIZE_XLSX=52428800

# Max image size: 20MB
MAX_FILE_SIZE_IMAGE=20971520

# Max audio size: 200MB
MAX_FILE_SIZE_AUDIO=209715200

# Max video size: 2GB
MAX_FILE_SIZE_VIDEO=2147483648

# Global max (500 MB per Section 2.3)
MAX_FILE_SIZE_MB=500

# Upload chunk read size (1MB per chunk)
UPLOAD_CHUNK_SIZE=1048576

# Enable SHA-256 dedup check vs Qdrant before processing
DEDUP_ENABLED=true

# Enable ClamAV malware scanning
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Enable AES-256 encryption for temp files
TEMP_FILE_ENCRYPTION=false

# Enable magic-byte MIME detection (always true in production)
MAGIC_BYTE_MIME_DETECTION=true


# ==============================================================================
# VIDEO PROCESSING — PySceneDetect; ffmpeg-python
# Subtitle extraction: SRT/ASS/VTT
# Thumbnail grid: 3×3 from keyframes
# HDR tone-map to SDR for vision model
# ==============================================================================

# Extract one keyframe per scene (PySceneDetect)
VIDEO_FRAME_INTERVAL_SEC=2

# Cap on total frames extracted per video
MAX_VIDEO_FRAMES=20

# FFMPEG binary path
FFMPEG_PATH=ffmpeg

# FFMPEG subprocess timeout (seconds)
FFMPEG_TIMEOUT_SEC=120

# Scene change threshold
SCENE_CHANGE_THRESHOLD=25.0

# Duplicate frame skip: cosine similarity threshold
VIDEO_DUPLICATE_FRAME_THRESHOLD=0.98

# Enable subtitle extraction (SRT/ASS/VTT)
VIDEO_SUBTITLE_EXTRACTION=true

# Enable HDR to SDR tone-mapping for vision model
VIDEO_HDR_TONEMAPPING=true

# Enable deinterlacing (yadif filter)
VIDEO_DEINTERLACE=false

# Thumbnail grid dimensions
VIDEO_THUMBNAIL_GRID_ROWS=3
VIDEO_THUMBNAIL_GRID_COLS=3

# > 10 GB: stream frame extraction (never load full file to RAM)
VIDEO_STREAM_THRESHOLD_BYTES=10737418240


# ==============================================================================
# INPUT VALIDATION — Phase 24 Pre-flight
# Magic-byte MIME detection; corrupt header recovery
# Disk-space guard before writing temp files
# ==============================================================================

# Allowed MIME types (empty = allow all detected types)
ALLOWED_MIME_TYPES=

# Allowed file extensions (empty = all supported types)
ALLOWED_FILE_TYPES=

# Pre-flight rejection target: <50ms
PREFLIGHT_MAX_MS=50

# WAV header validation target: <5ms
WAV_HEADER_VALIDATION_MAX_MS=5

# Minimum free disk space before writing temp files (MB)
MIN_FREE_DISK_MB=500

# Null byte stripping (log count when stripped)
STRIP_NULL_BYTES=true

# BOM detection and stripping
STRIP_BOM=true


# ==============================================================================
# SECURITY & COMPLIANCE
# PII redaction: presidio-analyzer + anonymizer
# Prompt injection: detect + strip before chunking
# Path traversal: pathlib.Path.resolve() + chroot check
# Audit logging: immutable append-only
# GDPR/CCPA: purge all chunks + embeddings + memory by user_id
# ==============================================================================

# Secret key for signing session tokens
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:7860,http://localhost:8000

# Rate limiting — requests per minute per user_id
RATE_LIMIT_RPM=60

# PII detection (Presidio) — enable in production
PII_DETECTION_ENABLED=false

# PII entity types to redact (comma-separated; empty = all)
# Options: PERSON, EMAIL_ADDRESS, PHONE_NUMBER, US_SSN, CREDIT_CARD, IP_ADDRESS, LOCATION
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD

# PII redaction operator: replace | hash | mask | redact
PII_REDACTION_OPERATOR=replace

# Prompt injection filter
PROMPT_INJECTION_FILTER_ENABLED=false

# Immutable audit log (append-only; never deleted)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log

# Path traversal chroot base (all file paths must resolve within this)
CHROOT_BASE=./data

# SSRF prevention: block RFC1918 private IP ranges
SSRF_BLOCK_PRIVATE_IPS=true


# ==============================================================================
# CROSS-MODAL FUSION
# ==============================================================================

CROSS_MODAL_FUSION_TIMEOUT=5.0
CROSS_MODAL_MIN_CONFIDENCE=0.1
CROSS_MODAL_MAX_CHUNKS_PER_MODALITY=5


# ==============================================================================
# LATENCY TARGETS (documented; enforced in code + Prometheus histograms)
# ==============================================================================

LATENCY_TARGET_IMAGE_MS=3000
LATENCY_TARGET_AUDIO_RTF=0.5
LATENCY_TARGET_PDF_MS=10000
LATENCY_TARGET_CROSS_MODAL_MS=5000
LATENCY_TARGET_PREFLIGHT_MS=50
LATENCY_TARGET_CACHE_HIT_MS=100
LATENCY_TARGET_EMBED_BATCH_MS=2000

# SLO targets per modality (ms) — used by Prometheus alerts
SLO_TEXT_P95_MS=2000
SLO_PDF_P95_MS=30000
SLO_WORD_P95_MS=15000
SLO_EXCEL_P95_MS=45000
SLO_IMAGE_P95_MS=10000
SLO_AUDIO_P95_MS=300000
SLO_VIDEO_P95_MS=900000


# ==============================================================================
# OBSERVABILITY — Langfuse LLM tracing
# ==============================================================================

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false


# ==============================================================================
# DSA LAYER
# ==============================================================================

LRU_CACHE_MAXSIZE=1000
PRIORITY_QUEUE_TOP_K=5
INVERTED_INDEX_MAX_VOCAB=50000


# ==============================================================================
# TEST / FIXTURE GENERATION
# ==============================================================================

TEST_FIXTURES_DIR=./tests/fixtures/phase24
TEST_AUDIO_SAMPLE_RATE=44100
TEST_AUDIO_DURATION_SEC=10
TEST_IMAGE_WIDTH=800
TEST_IMAGE_HEIGHT=600


# ==============================================================================
# KEYWORD EXTRACTION — YAKE / KeyBERT (per Section 4.1)
# ==============================================================================

# Keyword extractor: yake | keybert
KEYWORD_EXTRACTOR=yake

# Max keywords per chunk
KEYWORD_MAX_PER_CHUNK=10

# KeyBERT model (used if KEYWORD_EXTRACTOR=keybert)
KEYBERT_MODEL=all-MiniLM-L6-v2


# ==============================================================================
# DOCUMENT PROCESSING — PDF + Word
# ==============================================================================

# PDF OCR text density threshold (below this → trigger Tesseract fallback)
PDF_OCR_TEXT_DENSITY_THRESHOLD=0.1

# Enable LibreOffice headless pipeline for .doc → .docx conversion
LIBREOFFICE_ENABLED=true
LIBREOFFICE_PATH=libreoffice

# LibreOffice conversion timeout (seconds)
LIBREOFFICE_TIMEOUT_SEC=60

# Enable digital signature detection in PDFs
PDF_SIGNATURE_DETECTION=true

# Enable PDF JavaScript stripping (security)
PDF_STRIP_JAVASCRIPT=true

# Enable AcroForm field extraction
PDF_FORM_EXTRACTION=true

# Enable Word track changes detection
WORD_TRACK_CHANGES=true

# Enable Word macro detection flag
WORD_MACRO_DETECTION=true


# ==============================================================================
# EXCEL PROCESSING
# ==============================================================================

# Stream read_only mode for large Excel files
EXCEL_STREAM_READ_ONLY=true

# Max rows per sheet (safety cap)
EXCEL_MAX_ROWS=1000000