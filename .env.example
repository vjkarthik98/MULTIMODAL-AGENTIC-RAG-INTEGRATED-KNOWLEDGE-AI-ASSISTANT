# ==============================================================================
# .env.example — SECRETS + PER-ENVIRONMENT / PER-HARDWARE OVERRIDES ONLY.
# Copy to .env and fill in the secrets below.
#
# Every other setting (chunk sizes, retrieval weights, timeouts, model names,
# feature flags, etc.) has a hardcoded, production-tuned default in
# app/core/config.py (the Settings class) and does NOT belong here. Only add a
# line if it's a credential, or a value that genuinely differs between
# machines/deployments (dev vs prod, CPU laptop vs GPU box, which account owns
# the loaded KB, CORS origins, etc). If you need to override one of the
# defaults in config.py for your environment, add it here — the env var will
# take precedence.
# ==============================================================================


# ── ENVIRONMENT ────────────────────────────────────────────────────────────────
ENV=development
DEBUG=false

# ── HARDWARE PROFILE — leave everything below unset to let device_manager
# auto-detect CUDA vs CPU. Pin explicit values only if you need to force a
# device (e.g. a CPU-only dev machine, to silence device-demotion log spam) or
# match a specific deployment profile (AWS g6e.xlarge L40S = all_gpu). ──────
# MODELS_DEVICE_PROFILE=all_gpu
# EMBEDDER_DEVICE=cpu
# RERANKER_DEVICE=cpu
# SIGLIP_DEVICE=cpu
# BLIP_DEVICE=cpu
# WHISPER_DEVICE=cpu
# LLM_DEVICE_HINT=cpu
# QWEN2_VL_DEVICE=cpu
# TROCR_DEVICE=cpu
# DIARIZER_DEVICE=cpu
# NER_DEVICE=cpu

# CPU inference is slower than a GPU deployment — widen these if running on CPU.
# REQUEST_TIMEOUT_SEC=300
# MODEL_TIMEOUT_SEC=300
# LLM_CALL_TIMEOUT_SEC=120

# ── DEV-ONLY FLAGS ─────────────────────────────────────────────────────────────
# DEV_OTP_LOG=true → prints OTP/reset links to server console, skips SMTP (dev only)
DEV_OTP_LOG=false

# CORS allowed origins (comma-separated) — set to your real frontend origin(s) in production.
# The deployed UI is served same-origin by the app itself, so this only matters
# for a *different* origin calling the API directly (e.g. a portfolio site
# embedding a live-status widget or "try it" call). Production box value:
# CORS_ORIGINS=https://vk-ai-pi.vercel.app,http://3.208.159.124:8000
CORS_ORIGINS=http://localhost:7860,http://localhost:8000

# ── DEPLOYMENT/DATA IDENTITY ───────────────────────────────────────────────────
# Opaque UUID/dev user_id for data isolation in Qdrant, BM25, Redis, Mongo
DEFAULT_DEV_USER_ID=
# Eval harness: run as the account that owns the loaded KB
EVAL_USER_ID=


# ==============================================================================
# SECRETS — fill in your own; never commit real values; rotate immediately if exposed
# ==============================================================================

# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=

# Upstash Redis (REST)
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=

# MongoDB Atlas connection string (contains credentials)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0

# HuggingFace token — pyannote.audio model access + GGUF model access
# Get one at huggingface.co/settings/tokens
HF_TOKEN=

# Session/JWT signing key
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value. NEVER use this placeholder in production.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# Google OAuth2 — "Sign in with Google" (leave blank to disable)
# Get these from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Both below default to localhost — correct for `npm run dev`, WRONG for any
# real deployment. Google redirects the browser to OAUTH_REDIRECT_URI after
# consent; if it's left at the default, that's localhost:8000 on the VISITOR'S
# own machine, not the server — "localhost refused to connect", not a code
# bug. OAUTH_REDIRECT_URI must ALSO be added to the OAuth client's "Authorized
# redirect URIs" in Google Cloud Console — Google rejects any redirect_uri not
# on that allowlist, no matter what the server sends.
# Production: OAUTH_REDIRECT_URI=https://<your-domain-or-ip>/auth/callback/google
# Production: FRONTEND_URL=https://<your-domain-or-ip>
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback/google
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — OTP + password reset
SMTP_USER=
SMTP_PASSWORD=

# Tavily web search
TAVILY_API_KEY=


# ==============================================================================
# HARDWARE / DEVICE PINS — not secrets, but genuinely per-box
#
# Every one of these has a working default in app/core/config.py that
# auto-detects CUDA vs CPU (see _auto_device / _auto_whisper_compute), so you
# can leave this whole block commented out and the app runs correctly on a
# CPU laptop AND a GPU box. Uncomment only to PIN a value — e.g. to force a
# model onto CPU when debugging a VRAM issue, or to override auto-detection.
# ==============================================================================

# Device profile: auto | hybrid | all_gpu | all_cpu
# MODELS_DEVICE_PROFILE=all_gpu

# Per-model device pins (cuda | cpu). Blank/absent = auto-detect.
# EMBEDDER_DEVICE=cuda
# RERANKER_DEVICE=cuda
# SIGLIP_DEVICE=cuda
# BLIP_DEVICE=cuda
# WHISPER_DEVICE=cuda
# LLM_DEVICE_HINT=cuda
# QWEN2_VL_DEVICE=cuda
# TROCR_DEVICE=cuda
# DIARIZER_DEVICE=cuda
# NER_DEVICE=cuda

# VRAM cap — see docs/runbooks/phase-30-aws-deployment.md Stage 1 item 4.
# Set 46 on the 48GB L40S (g6e.xlarge) or the box silently uses less than
# half the card.
# VRAM_BUDGET_GB=46

# Load Qwen2-VL in INT8 instead of fp16 — see Stage 1 item 9 of the same
# runbook. Decide on real hardware; do not inherit blindly.
# QWEN2_VL_LOAD_IN_8BIT=true

# Timeouts — raise on slow/CPU-only boxes where model load or generation
# legitimately takes longer than the GPU-tuned defaults.
# REQUEST_TIMEOUT_SEC=300
# MODEL_TIMEOUT_SEC=300
# LLM_CALL_TIMEOUT_SEC=120

# Eval harness — the user_id whose ingested KB the eval suite scores against,
# and which judge to use. Must match a real ingested tenant or every retrieval
# metric scores an empty index. Also set as a GitHub Actions repo variable so
# eval-gate.yml's Tier-1 targets the same tenant.
# EVAL_USER_ID=
# EVAL_JUDGE_MODEL=prometheus_2_7b
