# .env.example — secrets and per-environment overrides only.
# Copy to .env and fill in the secrets below: cp .env.example .env
#
# Everything else (chunk sizes, retrieval weights, timeouts, model names,
# feature flags) already has a tuned default in app/core/config.py — only
# add a line here if it's a credential or a value that differs per machine.


# ── Environment ────────────────────────────────────────────────────────────
ENV=development
DEBUG=True


# ── Hardware profile ───────────────────────────────────────────────────────
# Leave commented out to auto-detect CUDA vs. CPU. Uncomment to pin a value.

# MODELS_DEVICE_PROFILE=all_gpu   # auto | hybrid | all_gpu | all_cpu

# Per-model device pins (cuda | cpu). Blank/absent = auto-detect.
# EMBEDDER_DEVICE=cpu
# RERANKER_DEVICE=cpu
# SIGLIP_DEVICE=cpu
# BLIP_DEVICE=cpu
# WHISPER_DEVICE=cpu
# LLM_DEVICE_HINT=cpu
# QWEN2_VL_DEVICE=cpu
# TROCR_DEVICE=cpu
# DIARIZER_DEVICE=cpu
# NER_DEVICE=cpu

# VRAM_BUDGET_GB=44               # cap in GB — use actual free VRAM, not nominal spec
# QWEN2_VL_LOAD_IN_8BIT=true      # INT8 instead of fp16, saves VRAM

# Idle model eviction — frees VRAM held by ingestion-only models (Whisper,
# BLIP2, Qwen2-VL, TrOCR, diarizer, NER, FinBERT) once they go idle, or
# sooner under VRAM pressure. The query hot set (LLM, embedder, reranker,
# SigLIP) is pinned and never evicted. See docs/runbooks/gpu-memory-management.md
# MODEL_IDLE_EVICTION_ENABLED=true
# MODEL_IDLE_TIMEOUT_SEC=300        # evict after this long unused
# MODEL_REAPER_INTERVAL_SEC=60      # how often to sweep (floored at 5s)
# MODEL_EVICT_VRAM_WATERMARK_GB=6   # urgent LRU evict below this free VRAM; 0 disables

# Raise these on CPU-only or otherwise slower hardware.
# REQUEST_TIMEOUT_SEC=300
# MODEL_TIMEOUT_SEC=300
# LLM_CALL_TIMEOUT_SEC=120


# ── Dev-only flags ─────────────────────────────────────────────────────────
DEV_OTP_LOG=false   # true = print OTP/reset links to console instead of sending email

# Allowed CORS origins, comma-separated. Required (no wildcard default) once
# the auth cookies carry real sessions — CORSMiddleware runs with
# allow_credentials=True, so an unset/"*" value would accept credentialed
# requests from any origin. Only matters if something other than the app
# itself (served same-origin, or proxied same-origin in dev) calls the API
# directly.
CORS_ORIGINS=http://localhost:7860,http://localhost:8000

# httpOnly session-cookie attributes (see app/auth/cookies.py). Leave unset
# in local dev — COOKIE_SECURE then defaults to false so cookies still work
# over plain http://localhost. Set COOKIE_SECURE=true (the default whenever
# ENV != development) in every real deployment, which requires HTTPS.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=


# ── Deployment / data identity ─────────────────────────────────────────────
DEFAULT_DEV_USER_ID=your-dev-user-id   # data-isolation key for Qdrant/BM25/Redis/Mongo
EVAL_USER_ID=your-eval-user-id         # user_id whose KB the eval suite scores against
# EVAL_JUDGE_MODEL=qwen2.5_7b


# ==============================================================================
# Secrets — fill in your own values. Never commit real credentials; rotate
# immediately if one is ever exposed.
# ==============================================================================

# Qdrant Cloud — vector store
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=paste-your-qdrant-api-key-here

# Upstash Redis (REST) — session cache
REDIS_URL=https://your-redis-instance.upstash.io
REDIS_TOKEN=paste-your-upstash-redis-token-here

# MongoDB Atlas — chat history / memory store
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0

# HuggingFace — pyannote.audio + gated GGUF model access (huggingface.co/settings/tokens)
HF_TOKEN=hf_paste_your_huggingface_token_here

# JWT signing key — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-output-of-secrets-token-hex-32

# Google OAuth2 — "Sign in with Google" (blank disables it). Console: console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-paste_your_google_client_secret_here
# Must match a redirect URI registered on the OAuth client above.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback/google
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — OTP + password-reset emails. Use a Gmail App Password, not your login password.
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=paste-your-gmail-app-password-here

# Tavily — web search for the agent's "search"/"hybrid" routes
TAVILY_API_KEY=tvly-paste_your_tavily_api_key_here
