# ==============================================================================
# CORE APPLICATION
# ==============================================================================

APP_NAME="Multimodal RAG Agentic Knowledge AI Assistant"
APP_VERSION="0.20.0"
APP_DESCRIPTION="Production Multimodal RAG + Agentic AI System"

# ENV: development | staging | production
ENV=development

# Enable debug logs — set false in production
DEBUG=false

# Server binding — use 127.0.0.1 for local dev, 0.0.0.0 for container
HOST=127.0.0.1
PORT=8000


# ==============================================================================
# PATHS
# ==============================================================================

# Root data directory (mounted volume in Docker)
DATA_DIR=./data

# Log output directory
LOG_DIR=./logs

# Directory for temporarily staging uploaded files during validation
UPLOAD_STAGING_DIR=./data/staging

# Directory for extracted video frames (cleaned up after ingestion)
VIDEO_FRAMES_DIR=./data/temp_frames

# Directory for images extracted from PDFs
PDF_IMAGE_DIR=./data/images


# ==============================================================================
# LOGGING
# ==============================================================================

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Use structured JSON logs (true in production, false for local readability)
LOG_JSON=false

# Include timestamps in console output
LOG_SHOW_TIMESTAMP=true

# Enable rotating file log
ENABLE_FILE_LOGGING=true
LOG_FILE_NAME=app.log

# Rotating file handler: 10MB per file, keep 5 backups
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# ==============================================================================
# PERFORMANCE & CONCURRENCY
# AMD Ryzen 7 7735HS — 8 cores / 16 threads, 16GB RAM
# CPU-only inference: conservative thread settings
# ==============================================================================

# Thread pool for sync-to-async bridging (Whisper, BLIP, Tesseract)
# Ryzen 7 7735HS: 8 physical cores — keep at 4 to leave headroom for OS + inference
THREAD_POOL_SIZE=4

# Max simultaneous FastAPI requests in flight
MAX_PARALLEL_REQUESTS=20

# HTTP request timeout (entire request lifecycle)
REQUEST_TIMEOUT_SEC=60

# Qdrant retrieval timeout
RETRIEVAL_TIMEOUT=10

# Embedding model inference timeout
EMBEDDING_TIMEOUT=15

# Qdrant client-level timeout
VECTOR_DB_TIMEOUT=10

# LLM inference timeout (Mistral 7B Q4 on CPU can be slow on long prompts)
MODEL_TIMEOUT_SEC=120

# Requests exceeding this threshold are logged as slow
SLOW_REQUEST_THRESHOLD=3.0


# ==============================================================================
# LLM — Mistral 7B Instruct v0.2 Q4_K_M (GGUF / llama-cpp-python)
# CPU inference: Q4_K_M is the best quality/speed tradeoff for AMD Ryzen
# ==============================================================================

# Absolute path to the GGUF model file
LLM_MODEL_PATH=./models/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# Max tokens to generate per completion
LLM_MAX_TOKENS=512

# Context window size (Mistral supports 4096; keep at 4096 for CPU safety)
CONTEXT_MAX_TOKENS=4096

# Sampling temperature — 0.0 for deterministic RAG answers
LLM_TEMPERATURE=0.2

# Top-p nucleus sampling
LLM_TOP_P=0.9

# Max characters accepted in a single prompt string (safety guard)
MAX_PROMPT_CHARS=8000

# GPU offload layers — 0 for CPU-only (Ryzen has no dedicated GPU)
LLM_GPU_LAYERS=0

# llama-cpp threads — half of logical cores; leave headroom for OS
LLM_THREADS=8

# Batch size for llama-cpp prompt processing
LLM_N_BATCH=512


# ==============================================================================
# EMBEDDINGS — sentence-transformers/all-MiniLM-L6-v2
# 384-dimensional, fast CPU inference
# ==============================================================================

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Batch size for embedding (32 is optimal for CPU RAM)
EMBEDDING_BATCH_SIZE=32

# Redis TTL for cached embeddings: 24 hours
EMBEDDING_CACHE_TTL=86400

# Output dimension of text embedding model
TEXT_EMBEDDING_DIM=384


# ==============================================================================
# VISION MODELS
# ==============================================================================

# CLIP model for cross-modal (image ↔ text) embedding
CLIP_MODEL=openai/clip-vit-base-patch32

# CLIP embedding dimension (must match Qdrant vision collection)
VISION_EMBEDDING_DIM=512

# BLIP model for image captioning
BLIP_MODEL=Salesforce/blip-image-captioning-base

# BLIP generation parameters
BLIP_MAX_TOKENS=64
BLIP_NUM_BEAMS=3

# Max image dimension before resize (larger = slower OCR/caption on CPU)
MAX_IMAGE_DIM=1024


# ==============================================================================
# ASR — Whisper (faster-whisper, base model)
# "base" is the correct tier for CPU-only on Ryzen 7
# ==============================================================================

WHISPER_MODEL=base

# Audio sample rate (must match Whisper expectation)
AUDIO_SAMPLE_RATE=16000

# Max audio file duration to process (seconds)
MAX_VIDEO_DURATION_SEC=300

# SNR threshold below which audio is flagged as noisy (dB)
AUDIO_SNR_THRESHOLD_DB=10.0

# Silence gap duration to flag as dropout (ms)
AUDIO_SILENCE_GAP_MS=200

# Max audio segments to process (safety against very long files)
MAX_AUDIO_SEGMENTS=500

# Whisper domain vocabulary boost — RAG/ML technical terms
# Comma-separated; used by WhisperX or post-processing correction
WHISPER_DOMAIN_VOCAB=RAG,FAISS,Qdrant,LlamaIndex,LangChain,RAGAS,Pinecone,ChromaDB,Mistral,OpenAI,Anthropic,embedding,retrieval,chunking,reranker,BM25,cosine,upsert


# ==============================================================================
# RERANKER — cross-encoder/ms-marco-MiniLM-L-6-v2
# ==============================================================================

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Reranking parameters
RERANK_TOP_K=5
RERANK_MAX_INPUT=20
RERANK_CONTEXT_MAX_CHARS=512

# Score weights for final ranking
RERANK_MODEL_WEIGHT=0.5
RERANK_FUSION_WEIGHT=0.5
RERANK_POSITION_WEIGHT=0.1


# ==============================================================================
# QDRANT — Cloud (Qdrant Cloud free tier or self-hosted)
# NEVER use local Qdrant in production — data not persisted across restarts
# ==============================================================================

# Cloud endpoint (preferred) — set QDRANT_URL to use cloud
# Example: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=

# Cloud API key (from Qdrant Cloud dashboard)
QDRANT_API_KEY=

# Local fallback (only for development when QDRANT_URL is empty)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Client-level timeout (seconds)
QDRANT_TIMEOUT=10

# Collection names — user-namespaced at runtime: user_{user_id}_{collection}
# These are the base names; runtime prepends user_{user_id}_
TEXT_COLLECTION_NAME=text_collection
VISION_COLLECTION_NAME=vision_collection
COLLECTION_NAME=rag_collection

# Batch size for Qdrant upsert operations
QDRANT_BATCH_SIZE=64

# Safety cap on total documents per collection
QDRANT_MAX_DOCS=100000

# Set true only in development to allow collection recreation on dim mismatch
QDRANT_ALLOW_RECREATE=false

# Retry settings for Qdrant init
QDRANT_INIT_RETRIES=2
QDRANT_RETRY_DELAY=1

# Max characters to store in Qdrant payload text field
QDRANT_TEXT_MAX_CHARS=2000


# ==============================================================================
# REDIS — Upstash Redis (cloud, free tier for dev)
# Used for: session cache, embedding cache, query result cache, rate limiting
# ==============================================================================

# Upstash REST URL (preferred for cloud)
# Example: https://glowing-frog-12345.upstash.io
REDIS_URL=

# Upstash REST token
REDIS_TOKEN=

# Local fallback (only when REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Connection timeout (seconds)
REDIS_TIMEOUT=5

# Default TTL for cached responses (24 hours)
REDIS_TTL_SECONDS=86400

# TTL for query result cache (1 hour — results may become stale)
REDIS_QUERY_CACHE_TTL=3600

# TTL for embedding cache (24 hours — embeddings are deterministic)
REDIS_EMBEDDING_CACHE_TTL=86400

# Key namespace prefix — all keys are: {prefix}:{user_id}:{type}:{hash}
REDIS_KEY_PREFIX=rag

# Enable Redis (false = in-memory LRU fallback; useful for local dev without Redis)
USE_REDIS=false


# ==============================================================================
# MONGODB ATLAS — Cloud (free M0 tier)
# Used for: long-term conversation memory, audit log, session summaries
# ==============================================================================

# Atlas connection string
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# Database name
MONGO_DB_NAME=rag_memory

# Server selection timeout (ms)
DB_TIMEOUT_MS=5000

# Connection pool size
DB_MAX_POOL_SIZE=20


# ==============================================================================
# CHUNKING
# ==============================================================================

# Chunk size in characters (512-token ≈ 2048 chars at avg 4 chars/token)
CHUNK_SIZE=512

# Overlap between consecutive chunks
CHUNK_OVERLAP=50

# Minimum chunk length to keep (discard shorter)
CHUNK_MIN_SIZE=50

# Hard cap on chunks per document
MAX_CHUNKS=200

# Ingestion batch size (how many docs to embed at once)
INGESTION_BATCH_SIZE=32


# ==============================================================================
# BM25 RETRIEVAL
# ==============================================================================

BM25_MAX_DOCS=10000
BM25_TOP_K=10
BM25_MIN_SCORE=0.1
BM25_MAX_TEXT_CHARS=1000
BM25_MAX_TOKENS=256


# ==============================================================================
# HYBRID RETRIEVAL — Weighted fusion of dense + sparse
# ==============================================================================

HYBRID_WEIGHT_BM25=0.4
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_VISION=0.2

# Retrieve N× top_k candidates before fusion (tradeoff: quality vs latency)
HYBRID_CANDIDATES_MULTIPLIER=3
HYBRID_MIN_SCORE=0.05


# ==============================================================================
# RESULT FUSION
# ==============================================================================

FUSION_SIMILARITY_THRESHOLD=0.7
FUSION_SCORE_WEIGHT=0.6
FUSION_QUALITY_WEIGHT=0.2
FUSION_MODALITY_WEIGHT=0.2
FUSION_MAX_INPUT=30
FUSION_MAX_TEXT_CHARS=1200
FUSION_MIN_SCORE=0.05


# ==============================================================================
# RAG RETRIEVAL
# ==============================================================================

DEFAULT_TOP_K=5
VECTOR_TOP_K=10
MAX_CONTEXT_DOCS=5
MAX_CONTEXT_CHARS=4000

RAG_TOP_K=5
RAG_DOC_MAX_CHARS=1200


# ==============================================================================
# QUERY DECOMPOSITION
# ==============================================================================

MAX_SUBQUERIES=3
SUBQUERY_MAX_TOKENS=64
DECOMPOSITION_MIN_WORDS=6
DECOMPOSITION_MAX_SUBQUERIES=3
DECOMPOSITION_CONFIDENCE_THRESHOLD=0.5


# ==============================================================================
# WEB SEARCH — Tavily
# ==============================================================================

# NEVER commit this key — rotate immediately if exposed
TAVILY_API_KEY=

WEB_MAX_DOCS=5
WEB_MAX_RESULTS=10
WEB_DOC_MAX_CHARS=1000
WEB_CONTEXT_MAX_CHARS=4000

# Search depth: basic | advanced
WEB_SEARCH_DEPTH=advanced


# ==============================================================================
# MEMORY
# ==============================================================================

MAX_HISTORY_MESSAGES=40
MAX_SYSTEM_MESSAGES=5

MEMORY_TOP_K=5
MEMORY_MAX_CONTEXT_CHARS=2000
MEMORY_SIM_THRESHOLD=0.3
MEMORY_RECENCY_SCALE=3600

MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_SUMMARY_INPUT_CHARS=4000
MIN_SUMMARY_LENGTH=50


# ==============================================================================
# AGENT
# ==============================================================================

AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SEC=10
AGENT_STEP_TIMEOUT_SEC=5
AGENT_HIGH_CONFIDENCE=0.7
AGENT_LOW_CONFIDENCE=0.4
AGENT_TOOL_TIMEOUT=10
AGENT_MAX_RETRIES=2
AGENT_ENABLE_DECOMPOSITION=true
AGENT_QUERY_EXPANSION_ENABLED=true


# ==============================================================================
# FILE UPLOAD — Per-modality size limits (bytes)
# Matches Phase 24 instruction SIZE_LIMITS
# ==============================================================================

# Max text file size: 10MB
MAX_FILE_SIZE_TEXT=10485760

# Max PDF size: 100MB
MAX_FILE_SIZE_PDF=104857600

# Max DOCX size: 50MB
MAX_FILE_SIZE_DOCX=52428800

# Max XLSX size: 50MB
MAX_FILE_SIZE_XLSX=52428800

# Max image size: 20MB
MAX_FILE_SIZE_IMAGE=20971520

# Max audio size: 200MB
MAX_FILE_SIZE_AUDIO=209715200

# Max video size: 2GB
MAX_FILE_SIZE_VIDEO=2147483648

# Legacy single limit (used by existing code — set to most permissive: video)
MAX_FILE_SIZE_MB=50

# Upload chunk read size (1MB per chunk)
UPLOAD_CHUNK_SIZE=1048576


# ==============================================================================
# VIDEO PROCESSING
# ==============================================================================

# Extract one frame every N seconds
VIDEO_FRAME_INTERVAL_SEC=2

# Cap on total frames extracted per video
MAX_VIDEO_FRAMES=20

# FFMPEG binary path — leave as "ffmpeg" if installed system-wide
FFMPEG_PATH=ffmpeg

# FFMPEG subprocess timeout (seconds)
FFMPEG_TIMEOUT_SEC=120

# Scene change threshold (pixel diff mean) for extra frame capture
SCENE_CHANGE_THRESHOLD=25.0


# ==============================================================================
# INPUT VALIDATION — Phase 24 Pre-flight
# ==============================================================================

# Allowed MIME types (empty string = allow all detected types)
# Populate this in production to whitelist only what your UI supports
ALLOWED_MIME_TYPES=

# Allowed file extensions (empty = all supported types)
ALLOWED_FILE_TYPES=

# Pre-flight rejection target: <50ms
# These are enforced in code; documented here for awareness
PREFLIGHT_MAX_MS=50

# WAV header validation target: <5ms
WAV_HEADER_VALIDATION_MAX_MS=5


# ==============================================================================
# PHASE 24 — CROSS-MODAL FUSION
# ==============================================================================

# Max time for cross-modal fusion (seconds)
CROSS_MODAL_FUSION_TIMEOUT=5.0

# Minimum confidence to include a modality's result in fusion
CROSS_MODAL_MIN_CONFIDENCE=0.1

# Max chunks per modality in cross-modal context
CROSS_MODAL_MAX_CHUNKS_PER_MODALITY=5


# ==============================================================================
# PHASE 24 — LATENCY TARGETS (documented; enforced in code)
# ==============================================================================

# Image processing (standard dashboard screenshot)
LATENCY_TARGET_IMAGE_MS=3000

# Audio real-time factor (must be < 0.5 × audio duration)
LATENCY_TARGET_AUDIO_RTF=0.5

# PDF extraction (50-page document)
LATENCY_TARGET_PDF_MS=10000

# Cross-modal dual-modality fusion
LATENCY_TARGET_CROSS_MODAL_MS=5000

# Pre-flight rejection (any modality)
LATENCY_TARGET_PREFLIGHT_MS=50

# Redis cache hit
LATENCY_TARGET_CACHE_HIT_MS=100

# Batch embedding (32 chunks)
LATENCY_TARGET_EMBED_BATCH_MS=2000


# ==============================================================================
# OBSERVABILITY
# ==============================================================================

# Langfuse — LLM call tracing (optional in dev; required in prod)
# Sign up at https://langfuse.com — free tier available
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Enable Langfuse tracing (false = no-op stub; true = real traces sent)
LANGFUSE_ENABLED=false

# Prometheus metrics endpoint exposure
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090


# ==============================================================================
# SECURITY
# ==============================================================================

# Secret key for signing session tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# CORS allowed origins (comma-separated; * is insecure in production)
# Example: http://localhost:7860,https://yourapp.example.com
CORS_ORIGINS=http://localhost:7860,http://localhost:8000

# Rate limiting — requests per minute per user_id
RATE_LIMIT_RPM=60

# PII detection (Presidio) — enable in production to scrub PII from logs
PII_DETECTION_ENABLED=false

# Prompt injection filter — enable in production
PROMPT_INJECTION_FILTER_ENABLED=false


# ==============================================================================
# DSA LAYER
# ==============================================================================

# LRU cache max entries (per-process; not Redis)
LRU_CACHE_MAXSIZE=1000

# Priority queue top-k for retrieval ranking
PRIORITY_QUEUE_TOP_K=5

# Sliding window memory max tokens (per session)
SLIDING_WINDOW_MAX_TOKENS=4096

# Inverted index max vocabulary size
INVERTED_INDEX_MAX_VOCAB=50000


# ==============================================================================
# TEST / FIXTURE GENERATION 
# ==============================================================================

# Root directory for Phase 24 test fixtures
TEST_FIXTURES_DIR=./tests/fixtures/phase24

# Synthetic test audio sample rate
TEST_AUDIO_SAMPLE_RATE=44100

# Test audio duration for fixture generation (seconds)
TEST_AUDIO_DURATION_SEC=10

# Test image resolution for fixture generation
TEST_IMAGE_WIDTH=800
TEST_IMAGE_HEIGHT=600